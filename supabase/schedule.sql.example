-- Run manually after functions and secrets have been deployed. Replace placeholders in the SQL Editor.
-- Cron runs at 06:00 UTC = 09:00 Asia/Riyadh each day.
create extension if not exists pg_cron with schema pg_catalog;
create extension if not exists pg_net with schema extensions;
select vault.create_secret('https://YOUR_PROJECT_REF.supabase.co','umj_project_url');
select vault.create_secret('YOUR_LONG_RANDOM_UMJ_CRON_SECRET','umj_cron_secret');
select cron.schedule('umj-weekly-push-riyadh','0 6 * * *',$$
  select net.http_post(
    url := (select decrypted_secret from vault.decrypted_secrets where name='umj_project_url') || '/functions/v1/umj-weekly-push',
    headers := jsonb_build_object('Content-Type','application/json','X-Cron-Secret',(select decrypted_secret from vault.decrypted_secrets where name='umj_cron_secret')),
    body := '{}'::jsonb
  ) as request_id;
$$);
